using Toybox.Graphics;

//! 입력 도구 주소를 담은 QR 코드.
//!
//!   https://minheokchoi.github.io/garmin-timetable/
//!
//! 시계에서 URL 을 글자로 보여줘 봐야 읽지도 옮겨 적지도 못한다.
//! 폰으로 바로 넘어갈 수 있게 QR 로 띄운다.
//!
//! 이미지가 아니라 모듈 배열로 들고 있는 이유:
//!   - PNG 로 넣으면 기기마다 같은 픽셀 크기로 나와서 큰 화면에서 작게 보인다.
//!     사각형으로 그리면 화면에 맞춰 커진다. 모듈이 클수록 잘 스캔된다.
//!   - 29x29 문자열이라 1KB 도 안 된다.
//!
//! 주소가 바뀌면 이 배열을 다시 만들어야 한다 (오류정정 L, 29모듈).
module Qr {

    const SIZE = 29;

    const ROWS = [
        "11111110111100101100001111111",
        "10000010000111000001001000001",
        "10111010010101100011001011101",
        "10111010001101011101101011101",
        "10111010001110001011001011101",
        "10000010010100100110101000001",
        "11111110101010101010101111111",
        "00000000110011100010000000000",
        "11011010010010101101001000001",
        "01101001001001110001000110110",
        "10101111010010111100100110100",
        "01011101000000100101111101001",
        "00100010011010001000101100001",
        "10100000111010111010101111111",
        "10110011011001111111100000101",
        "11001001010100011010110100101",
        "01011110101011011011100101000",
        "10011100011010010011100010110",
        "11111011010101010001010011001",
        "11011001100001000010011001100",
        "11111010111010111100111111110",
        "00000000100100010110100011000",
        "11111110011110011111101011000",
        "10000010000100010101100010010",
        "10111010110010011001111111000",
        "10111010111101111111110000001",
        "10111010010011010101110110111",
        "10000010100110010000001111101",
        "11111110101111000011101000000"
    ];

    //! 원형 화면의 내접 정사각형 안에 그린다. 모서리가 잘리면 위치 검출
    //! 패턴이 깨져서 인식이 안 된다.
    //!
    //! 흰 여백(quiet zone)이 없으면 스캐너가 경계를 못 잡는다. 시계 배경이
    //! 검정이라 QR 뒤에 흰 사각형을 깔고 그 안쪽에 여백을 둔다.
    function draw(dc) {
        var w = dc.getWidth();
        var h = dc.getHeight();
        var side = (w < h) ? w : h;

        // 원형은 내접 정사각형 안에 넣어야 모서리가 안 잘린다 (지름/루트2 ≈ 99/140).
        // 사각 화면은 그 제약이 없으니 짧은 변을 거의 다 쓴다. 모듈이 커져 잘 읽힌다.
        var box = Theme.isRound() ? (side * 99) / 140 : (side * 92) / 100;
        var quiet = 3;
        var unit = box / (SIZE + quiet * 2);
        if (unit < 1) { unit = 1; }

        var full = unit * (SIZE + quiet * 2);
        var x0 = (w - full) / 2;
        var y0 = (h - full) / 2;

        dc.setColor(Graphics.COLOR_WHITE, Graphics.COLOR_WHITE);
        dc.fillRectangle(x0, y0, full, full);

        dc.setColor(Graphics.COLOR_BLACK, Graphics.COLOR_TRANSPARENT);
        var ox = x0 + quiet * unit;
        var oy = y0 + quiet * unit;

        // 가로로 이어진 검은 모듈은 한 번에 그린다. 사각형 호출을 줄이면
        // 이 화면을 그리는 데 걸리는 시간이 눈에 띄게 준다.
        for (var r = 0; r < SIZE; r++) {
            var row = ROWS[r];
            var c = 0;
            while (c < SIZE) {
                if (!row.substring(c, c + 1).equals("1")) { c++; continue; }
                var run = 1;
                while (c + run < SIZE && row.substring(c + run, c + run + 1).equals("1")) { run++; }
                dc.fillRectangle(ox + c * unit, oy + r * unit, run * unit, unit);
                c += run;
            }
        }
    }
}
